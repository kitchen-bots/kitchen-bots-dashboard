{
  "name": "kitchen-bots-dashboard",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "sync:catalog:check": "node scripts/sync-catalog.mjs --check"
  },
