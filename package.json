    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "firebase": "^12.19.0",
    "framer-motion": "^11.2.10",
    "hono": "^4.13.8",
    "lucide-react": "^0.395.0",
    "nanoid": "^3.3.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
