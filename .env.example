# ---------------- Public variables (safe for the browser) ----------------

# Firebase web app configuration (public by design)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL of the Worker API (no trailing slash), e.g. http://127.0.0.1:8787 in dev
VITE_API_BASE_URL=

# Cloudflare Turnstile site key (public)
VITE_TURNSTILE_SITE_KEY=

# Connect Auth and Firestore to the local Firebase emulators in development.
VITE_USE_FIREBASE_EMULATORS=false

# ---------------- Legacy (to be removed after migration) ----------------

# Google Apps Script Web App Deployment URL (legacy Google Sheets backend)
VITE_GAS_WEB_APP_URL=""

# ---------------- Worker secrets (NOT VITE_, never in the browser) --------
# Set in worker/.dev.vars for local dev, or via `wrangler secret put`:
#   FIREBASE_PROJECT_ID
#   FIREBASE_CLIENT_EMAIL
#   FIREBASE_PRIVATE_KEY
#   TURNSTILE_SECRET_KEY
#   RESEND_API_KEY
