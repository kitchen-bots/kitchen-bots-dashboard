{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kitchen-bots-dashboard",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
